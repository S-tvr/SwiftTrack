# Copy to .env.test (gitignored) before running `npm run test:e2e`.
# Mirrors the .env / .env.example convention already used for development.
#
# Loaded by test/setup-e2e.ts with override:true, BEFORE AppModule is imported.
# That ordering is load-bearing: ConfigModule.forRoot() in AppModule also loads
# backend/.env, but dotenv never overwrites a key that is already present in
# process.env — so whatever this file sets wins over the development .env.

# MUST point at a database whose name ends in _test. The suite truncates tables
# between tests, and test/helpers/env.ts refuses to run against anything else.
DATABASE_URL="postgresql://swifttrack:swifttrack@localhost:5432/swifttrack_test"

JWT_SECRET="e2e-only-secret-not-used-anywhere-else"

# Deliberately NOT http://localhost:5173. That value is the hardcoded fallback in
# main.ts, so a CORS assertion against it would pass even if the env var were
# never read — the lesson from step 1.
FRONTEND_URL="http://e2e-origin.test:9999"

# Consumed by prisma/seed.ts. Unlike development, these are known to the suite:
# the tests log in as this admin to obtain a token.
ADMIN_NAME="E2E Admin"
ADMIN_EMAIL="admin@e2e.local"
ADMIN_PASSWORD="e2e-admin-password"
