generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // Defaults to "inferred from environment", which is not reproducible: the same
  // Prisma 7.9.1 emitted `./internal/class.js` on the development machine and
  // `./internal/class.ts` inside the Docker image, and the second one crashes at
  // startup with MODULE_NOT_FOUND — tsc rewrites neither specifier. We compile to
  // JavaScript and run `node dist/src/main.js`, so `.js` is the correct answer
  // everywhere and is now stated rather than guessed.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String?
  role                Role
  hourlyRate          Int?
  isActive            Boolean   @default(true)
  setupCode           String?
  setupCodeExpiresAt  DateTime?
  // Bumped whenever every token issued for this user must stop working. Signed
  // into the JWT and compared on every request by JwtStrategy, which already
  // reads this row to check isActive — so revocation costs no extra query.
  // Only change-password bumps it: activation cannot have issued a token yet,
  // and deactivation is already enforced live through isActive.
  tokenVersion        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  timeEntries         TimeEntry[]
  rates               UserRate[]
}

// One employee's pay history: what they were paid, and from when.
//
// `User.hourlyRate` above is what they are paid *now* — the denormalised head of
// this history, read by /users, /users/me and the login response, none of which
// is a cycle-aware question. This table is what they were paid *then*, and it is
// the only thing payroll reads. Without it a raise would reprice every cycle the
// employee had ever worked, because pay is derived from the rate on every
// request and nothing would record what the rate used to be.
//
// The two are written together in one transaction (UsersService), so the head
// can never disagree with the newest row here.
model UserRate {
  id            Int      @id @default(autoincrement())
  hourlyRate    Int
  // The instant this rate starts applying — always a cycle-start instant (UTC
  // midnight), i.e. a value computeCycleRange().start can produce.
  //
  // Deliberately an instant and not a "2026-07" cycle key: a key needs
  // cycleStartDay to interpret, so an admin moving the cycle boundary would
  // silently re-interpret every stored row and move history again — the exact
  // bug this table exists to prevent. Same discipline as endExclusive.
  effectiveFrom DateTime
  userId        Int
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])

  // Two rates in force from the same instant is not a state with an answer.
  // Also the key the rate write upserts on, so two raises inside one cycle
  // collapse to a single row for the next one instead of colliding.
  @@unique([userId, effectiveFrom])
  // Every lookup is "the greatest effectiveFrom at or before this instant".
  @@index([userId, effectiveFrom])
}

model TimeEntry {
  id        Int       @id @default(autoincrement())
  userId    Int
  startTime DateTime
  endTime   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, startTime])
}

// DB also has a `CHECK ("id" = 1)` constraint, added by hand in a migration
// (Prisma has no native syntax for it) — enforces the single-row invariant
// below the application layer too. See migrations/..._appsettings_singleton_check.
model AppSettings {
  id            Int @id @default(1)
  cycleStartDay Int @default(25)
  cycleEndDay   Int @default(24)
}
