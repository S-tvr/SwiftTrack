generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String?
  role                Role
  hourlyRate          Int?
  isActive            Boolean   @default(true)
  setupCode           String?
  setupCodeExpiresAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  timeEntries         TimeEntry[]
}

model TimeEntry {
  id        Int       @id @default(autoincrement())
  userId    Int
  startTime DateTime
  endTime   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, startTime])
}

// DB also has a `CHECK ("id" = 1)` constraint, added by hand in a migration
// (Prisma has no native syntax for it) — enforces the single-row invariant
// below the application layer too. See migrations/..._appsettings_singleton_check.
model AppSettings {
  id            Int @id @default(1)
  cycleStartDay Int @default(25)
  cycleEndDay   Int @default(24)
}
