# Shell scripts and Docker-related files must keep LF endings even when cloned on
# Windows (this repo was developed with core.autocrlf=true). A CRLF entrypoint is
# copied verbatim into the Linux image and fails at startup with
# "bad interpreter: /bin/sh^M", which is a confusing way to learn about line endings.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf

# Let git normalise everything else and detect binaries on its own.
* text=auto
