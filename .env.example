# Optional. `docker compose up` works without this file — every value below has a
# development default baked into docker-compose.yml. Copy this to .env only when you
# want to override one.
#
#     cp .env.example .env
#
# .env is gitignored. These defaults are placeholders for local development and must
# never be used for a real deployment.

# Signs the JWTs. Generate a real one with:  openssl rand -base64 48
JWT_SECRET=dev-only-not-for-production

# The first admin account, created by prisma/seed.ts on first boot.
# Changing these after the database already exists creates a *second* admin —
# the seed matches on email and leaves an existing account alone.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@swifttrack.local
ADMIN_PASSWORD=admin1234

# Set to false to start with an empty roster (admin only, no demo employees).
SEED_DEMO=true

# Which host interface the published ports bind to. Defaults to 127.0.0.1, so the
# app is reachable from this machine only — the right default while the JWT secret
# and admin password above are the committed placeholders.
#
# Set to 0.0.0.0 to expose it on your network, and change the two URLs below to
# match, or the browser will call an address it cannot reach and CORS will reject it.
# VITE_API_URL is inlined at build time, so this combination needs
# `docker compose up --build`, not just a restart.
#BIND_HOST=0.0.0.0
#VITE_API_URL=http://192.168.1.10:3000
#FRONTEND_URL=http://192.168.1.10:5173
