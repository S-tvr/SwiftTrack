# Base URL of the SwiftTrack backend.
#
# Required — there is no fallback. api/client.ts throws at startup when this is
# missing, instead of silently defaulting to http://localhost:3000: Vite exposes
# only VITE_-prefixed variables, so a misspelt name resolves to undefined, and a
# default equal to the real dev value would hide that until deploy.
#
# Vite inlines this at BUILD time, not at runtime — set it before `npm run build`.
VITE_API_URL=http://localhost:3000
